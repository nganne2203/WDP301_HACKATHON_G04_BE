  "main": "src/server.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('src','dist',{recursive:true});\"",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.js"
  },
  "imports": {
    "#configs/*": "./src/configs/*",
    "#constants/*": "./src/constants/*",
    "#middlewares/*": "./src/middlewares/*",
    "#models/*": "./src/models/*",
    "#modules/*": "./src/modules/*",
    "#routes/*": "./src/routes/*",
    "#utils/*": "./src/utils/*",
    "#repositories/*": "./src/repositories/*",
    "#services/*": "./src/services/*"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "googleapis": "^172.0.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
